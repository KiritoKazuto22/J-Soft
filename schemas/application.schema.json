{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "J-Soft Application Catalog",
  "type": "object",
  "required": ["schemaVersion", "applications"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "category", "packageManager", "packageId", "enabled", "requiresAdmin"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "packageManager": { "type": "string", "enum": ["winget", "chocolatey"] },
          "packageId": { "type": "string", "minLength": 1 },
          "packageSource": { "type": "string", "enum": ["winget", "msstore"] },
          "chocolateyPackageId": { "type": "string" },
          "website": { "type": "string" },
          "isFoss": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "requiresAdmin": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
